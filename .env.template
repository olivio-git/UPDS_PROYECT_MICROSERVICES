# ==============================================================================
# CBA Evaluation Platform — environment template
#
# Copy to .env and fill in real values:  cp .env.template .env
# Every key below is read by at least one service. Services now fail to start
# when a required secret is missing, rather than falling back to a default.
# ==============================================================================

# --- General ---------------------------------------------------------------
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:80

# --- Service ports ---------------------------------------------------------
AUTH_SERVICE_PORT=3000
NOTIFICATION_SERVICE_PORT=3001
USER_MANAGEMENT_SERVICE_PORT=3002
EXAM_SERVICE_PORT=3003
SESSION_MANAGER_PORT=3004

# --- MongoDB ---------------------------------------------------------------
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DB_NAME=cba_platform
MONGO_AUTH_DB_NAME=cba_auth_db
MONGO_NOTIFICATION_DB_NAME=cba_notification_db
MONGO_COLLECTION_CREDENTIAL=credentials
MONGO_COLLECTION_EMAIL=email
# Must match notifications-service's default, the indexes in
# scripts/cleanup-and-migrate.js and the grading e2e test.
MONGO_COLLECTION_EMAILS=notification_emails

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=

# --- Secrets (REQUIRED — services refuse to start without these) -----------
# Must be identical across services: they sign and verify the same tokens.
JWT_SECRET=
REFRESH_TOKEN_SECRET=
JWT_EXPIRATION=1h
# Shared secret for service-to-service calls (auth-service <-> user-management)
SERVICE_TOKEN=

# --- MinIO (object storage for exam media) ---------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=exam-files

# --- GROQ (AI grading + question generation) -------------------------------
# Used by grading-service and by exam-service for PDF report interpretation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Resend (transactional email) ------------------------------------------
RESEND_API_KEY=
