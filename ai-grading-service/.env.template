# App Configuration
PORT=3006
DEBUG=true
APP_NAME=AI Grading Service

# Database
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=cba_grading
REDIS_URI=redis://redis:6379
REDIS_PREFIX=ai_grading:

# Services URLs (Retrocompatibilidad)
AUTH_SERVICE_URL=http://auth-service:3000
EXAM_SERVICE_URL=http://exam-service:3003
SESSION_MANAGER_URL=http://session-manager:3004
USER_MANAGEMENT_URL=http://user-management-service:3002

# AI Models
WHISPER_MODEL=base
SPACY_MODEL=en_core_web_sm
MAX_AUDIO_SIZE_MB=10
MAX_TEXT_LENGTH=5000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_ID=ai-grading-service
KAFKA_GROUP_ID=ai-grading-group

# Security
JWT_SECRET=your-jwt-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
