# AI Grading Service Configuration

# Server Configuration
HOST=0.0.0.0
PORT=3006
ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Database Configuration
MONGODB_URL=mongodb://localhost:27017/exam_platform
REDIS_URL=redis://localhost:6379

# Ollama Configuration for Question Generation
OLLAMA_URL=https://ollama-354865198391.us-central1.run.app
OLLAMA_MODEL=llama3.2:3b-instruct-q4_0
LLM_ENABLED=true
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# spaCy Configuration
SPACY_MODEL=es_core_news_sm
LANGUAGE_TOOL_LANG=es

# Text Processing
LLM_FEEDBACK_FORMAT=markdown
TEXT_MAX_LENGTH=5000
QUESTION_MAX_LENGTH=1000

# Service Configuration
JWT_SECRET=your-jwt-secret-here
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO

# Question Generation Configuration
MAX_QUESTIONS_PER_REQUEST=5
MAX_BULK_REQUESTS=10
DEFAULT_DIFFICULTY=3
DEFAULT_POINTS=1

# Cache Configuration
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600

# Feature Flags
ENABLE_AUDIO_PROCESSING=true
ENABLE_GRAMMAR_CHECK=true
ENABLE_QUESTION_GENERATION=true
ENABLE_COMPREHENSIVE_EVALUATION=true