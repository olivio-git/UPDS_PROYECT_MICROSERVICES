          subgraph Microservices
            Auth[auth-service\n(port 3000)]
            Notif[notifications-service\n(port 3001)]
            UserMgmt[user-management-service\n(port 3002)]
            Exam[exam-service\n(port 3003)]
            Session[session-manager-service\n(port 3004)]
            AI[ai-grading-service\n(port 3006)]
          end

          subgraph Infra
            Mongo[(MongoDB)]
            Redis[(Redis)]
