# Dockerfile for Exam Service with Puppeteer support
FROM node:18-slim

# Install dependencies for Puppeteer and Chrome
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    procps \
    libxss1 \
    && wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && sh -c 'echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list' \
    && apt-get update \
    && apt-get install -y google-chrome-stable fonts-ipafont-gothic fonts-wqy-zenhei fonts-thai-tlwg fonts-kacst fonts-freefont-ttf libxss1 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Install dumb-init
RUN apt-get update && apt-get install -y dumb-init && rm -rf /var/lib/apt/lists/*

# Build context is the repo root (see docker-compose.yml), so paths below
# are relative to it.

WORKDIR /app

# Build the shared @cba/events package and pack it into a tarball. Services
# depend on it via "file:../shared/events/cba-events.tgz" — a real tarball
# install (not an npm-created symlink) so peerDependencies (kafkajs) resolve
# from the *service's* node_modules instead of shared/events' realpath.
COPY shared/events/package*.json shared/events/tsconfig*.json ./shared/events/
COPY shared/events/src ./shared/events/src
RUN cd shared/events && npm install && npm run pack:local

# Create working directory for this service
WORKDIR /app/exam-service

# Copy package files
COPY exam-service/package*.json ./

# The @cba/events tarball is rebuilt on every image build and is not
# byte-reproducible, so its integrity hash in package-lock.json goes stale and
# even `npm install` fails with EINTEGRITY on a clean build (a warm Docker
# cache hides it). Drop only that entry's integrity before installing; every
# other dependency is still checked. Same logic as scripts/ci/install-with-local-events.sh.
RUN node -e 'const fs=require("fs");const l=JSON.parse(fs.readFileSync("package-lock.json","utf8"));const e=l.packages&&l.packages["node_modules/@cba/events"];if(e)delete e.integrity;fs.writeFileSync("package-lock.json",JSON.stringify(l,null,2));' && \
    npm install && \
    npx puppeteer browsers install chrome

# Copy source code
COPY exam-service/. .

# Build the application
RUN npm run build

# Prune dev dependencies to keep the image small
RUN npm prune --production && npm cache clean --force

# Create non-root user
RUN groupadd -r nodejs && useradd -r -g nodejs -G audio,video nodejs \
    && mkdir -p /home/nodejs/Downloads \
    && chown -R nodejs:nodejs /home/nodejs

# Change ownership
RUN chown -R nodejs:nodejs /app
USER nodejs

# Set Chrome executable path for Puppeteer
ENV CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Expose port
EXPOSE 3003

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3003/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start command
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]