# Session Manager Service Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3004
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# MongoDB Configuration
MONGO_URI=mongodb://username:password@mongo:27017/cba_sessions?authSource=admin
MONGO_DB_NAME=cba_sessions

# Redis Configuration (opcional para cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_random

# Kafka Configuration
KAFKA_CLIENT_ID=session-manager-service
KAFKA_BROKER=kafka:29092
KAFKA_GROUP_ID=session-manager-group

# Kafka Topics
KAFKA_TOPIC_SESSION_EVENTS=session-events
KAFKA_TOPIC_EXAM_EVENTS=exam-events
KAFKA_TOPIC_NOTIFICATION_EVENTS=notification-events

# External Services URLs
EXAM_SERVICE_URL=http://exam-service:3003
NOTIFICATION_SERVICE_URL=http://notification-service:3001
USER_MANAGEMENT_SERVICE_URL=http://user-management-service:3002
AI_SERVICE_URL=http://ai-service:3005

# WebSocket Configuration
WEBSOCKET_PING_TIMEOUT=60000
WEBSOCKET_PING_INTERVAL=25000

# Frontend URL (for notifications)
FRONTEND_URL=http://localhost:5173

# Service Instance (for load balancing)
HOSTNAME=session-manager-1

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# Performance Configuration
MAX_CONCURRENT_SESSIONS=100
MAX_PARTICIPANTS_PER_SESSION=200
SESSION_CLEANUP_INTERVAL=3600000

# Development specific
DEBUG=session-manager:*
