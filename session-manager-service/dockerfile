# Build stage
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Prune dev dependencies to keep the image small
RUN npm prune --production

# Production stage
FROM node:18-alpine AS production

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S session-manager -u 1001

# Copy built application
COPY --from=builder --chown=session-manager:nodejs /app/dist ./dist
COPY --from=builder --chown=session-manager:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=session-manager:nodejs /app/package*.json ./
RUN mkdir /app/logs && chown session-manager:nodejs /app/logs

# Set user
USER session-manager

# Expose port
EXPOSE 3004

# Health check
# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3004/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1) })"

# Start the application
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
